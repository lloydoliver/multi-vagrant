# Settings file for Vagrant VMs.
#
# This file controls different aspects of your vagrant environment.
#
# Copy this example file to ../config.yaml and edit to your needs.
#
# SETTINGS (global configuration)
# ================================
# settings:
#   codebase: ~/your/local/code             (** required **)
#   codedest: /some/remote/dir              (** required **)
#   domain: dev.arpa                        (optional, default: dev.arpa)
#   defaultbox: bento/ubuntu-22.04          (optional)
#   masterbox: bento/ubuntu-22.04           (optional)
#   mastername: master                      (optional)
#   network: 192.168.56                     (optional, omit last octet)
#   provider: virtualbox                    (optional, options: virtualbox, vmware_desktop, vmware_fusion, lxc)
#   provisioner: none                       (optional, options: none, ansible, salt)
#   master: true                            (optional, set to false to disable master VM)
#
# MASTER VM CONFIGURATION (optional)
# ==================================
# master:
#   ram: 2048                               (optional, default: 1024)
#   cpu: 2                                  (optional, default: 1)
#   folders:                                (optional, additional shared folders)
#     - from: ~/extra/path
#       to: /extra/mount
#
# CLIENT VMS
# ==========
# vms:
#   - name: myvm                    (** required **, alphanumeric and hyphens only)
#     box: bento/ubuntu-22.04       (optional)
#     ram: 2048                     (optional, default: 512)
#     cpu: 4                        (optional, default: 1)
#     domain: custom.domain         (optional, overrides global domain)
#     provider: lxc                 (optional, overrides global provider)
#     folders:                      (optional)
#       - from: '/local/path'
#         to: '/vm/path'


settings:
  domain: dev.arpa
  defaultbox: bento/ubuntu-22.04
  codebase: /your/code/dir
  codedest: /srv/code
  provider: virtualbox
  provisioner: ansible

master:
  ram: 2048
  cpu: 2

vms:
  - name: dev1
    cpu: 4
    ram: 8192

  - name: dev2
    ram: 4096

  - name: dev3

