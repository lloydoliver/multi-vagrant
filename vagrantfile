# -*- mode: ruby -*-
# vi: set ft=ruby :

# Minimum vagrant version and Vagrant API version needed.
Vagrant.require_version ">= 1.9.2"
API_VERSION = "2"
require 'yaml'

# read YAML file to get config data and vm details
config          = YAML.load_file('config.yaml')
settings        = config['settings']        || {}
vms             = config['vms']             || []
defaultdomain   = settings['domain']        || 'local.dev'
defaultbox      = settings['defaultbox']    || 'ubuntu/xenial64'
masterbox       = settings['masterbox']     || defaultbox
mastername      = settings['mastername']    || 'master'
network         = settings['network']       || '192.168.56'
codebase        = settings['codebase']      || {}
codedest        = settings['codedest']      || {}
defaultprovider = settings['provider']      || 'virtualbox'

# Explicitly set default provider to virtualbox
ENV['VAGRANT_DEFAULT_PROVIDER'] = defaultprovider

defaultproviderfile = File.expand_path('providers/checks/' + defaultprovider)
eval File.read(defaultproviderfile) if File.exists?(defaultproviderfile)

# Create master box
Vagrant.configure(API_VERSION) do |config|
  mname = mastername + '.' + defaultdomain
  config.vm.define mname do |master|
    master.vm.box = masterbox
    master.vm.network :private_network, ip: network + '.10'
    master.vm.hostname = mastername
    master.ssh.insert_key = false
    master.vm.synced_folder codebase, codedest
    master.vm.provider :virtualbox do |v|
      v.customize ["modifyvm", :id, "--memory", 1024]
      v.customize ["modifyvm", :id, "--name", mname]
    end
  end

  # Iterate through entries in YAML file
  count = 12 # set starting number for last octect of IP address
  vms.each do |server|
    cpu       = server['cpu']       || 1
    ram       = server['ram']       || '512'
    box       = server['box']       || defaultbox
    box_url   = server['boxurl']    || false
    folders   = server['folders']   || false
    domain    = server['domain']    || defaultdomain
    name      = server['name'] + '.' + domain
    ip        = network.to_s + '.' + count.to_s
    provider  = server['provider']  || defaultprovider

    # Increase count number for IP address usage
    count     += 1

    # Create the VM
    config.vm.define name do |dev|
      dev.vm.hostname = name
      dev.ssh.insert_key = false
      dev.vm.box = box
      if box_url
        dev.vm.box_url = box_url
      end
      if folders
        for pair in folders
          dev.vm.synced_folder pair['from'], pair['to']
        end
      end

      providerfile = File.expand_path('providers/' + provider)
      eval File.read(providerfile)

    end
  end
end
