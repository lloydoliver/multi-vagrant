# -*- mode: ruby -*-
# vi: set ft=ruby :

# Minimum vagrant version and Vagrant API version needed.
Vagrant.require_version '>= 2.4.3'
API_VERSION = '2'
require 'yaml'

# Valid providers and provisioners
VALID_PROVIDERS = %w[virtualbox vmware_desktop vmware_fusion lxc].freeze
VALID_PROVISIONERS = %w[none ansible salt].freeze

# Helper function for consistent error messages
def config_error(message)
  puts "[ERROR] #{message}"
  exit 1
end

# Check config.yaml exists
config_file = File.join(__dir__, 'config.yaml')
unless File.exist?(config_file)
  config_error "config.yaml not found. Copy examples/config.yaml.example to config.yaml and configure it."
end

# Read YAML file to get config data and vm details
config_data     = YAML.load_file(config_file)
settings        = config_data['settings']     || {}
vms             = config_data['vms']          || []
master_config   = config_data['master']       || {}

# Global settings with defaults
default_domain    = settings['domain']        || 'dev.arpa'
default_box       = settings['defaultbox']    || 'bento/ubuntu-22.04'
network           = settings['network']       || '192.168.56'
default_provider  = settings['provider']      || 'virtualbox'
provisioner       = settings['provisioner']   || 'none'
codebase          = settings['codebase']
codedest          = settings['codedest']
enable_master     = settings.fetch('master', true)

# Master VM settings (can override globals)
master_name   = settings['mastername']        || 'master'
master_box    = settings['masterbox']         || default_box
master_ram    = master_config['ram']          || 1024
master_cpu    = master_config['cpu']          || 1
master_folders = master_config['folders']     || []

# Validate required settings
if codebase.nil? || codebase.to_s.empty?
  config_error "settings.codebase is required - path to your local code directory"
end
if codedest.nil? || codedest.to_s.empty?
  config_error "settings.codedest is required - mount point on the master VM"
end

# Validate provider
unless VALID_PROVIDERS.include?(default_provider)
  config_error "Invalid provider '#{default_provider}'. Valid options: #{VALID_PROVIDERS.join(', ')}"
end

# Validate provisioner
unless VALID_PROVISIONERS.include?(provisioner)
  config_error "Invalid provisioner '#{provisioner}'. Valid options: #{VALID_PROVISIONERS.join(', ')}"
end

# Validate VM configurations
vms.each_with_index do |vm, index|
  unless vm['name']
    config_error "vms[#{index}]: 'name' is required"
  end

  # Validate hostname format (alphanumeric and hyphens only)
  unless vm['name'] =~ /\A[a-zA-Z0-9][a-zA-Z0-9\-]*\z/
    config_error "vms[#{index}]: name '#{vm['name']}' is invalid. Use only alphanumeric characters and hyphens."
  end

  # Validate per-VM provider if specified
  if vm['provider'] && !VALID_PROVIDERS.include?(vm['provider'])
    config_error "vms[#{index}]: Invalid provider '#{vm['provider']}'. Valid options: #{VALID_PROVIDERS.join(', ')}"
  end

  # Validate ram is numeric if specified
  if vm['ram'] && !vm['ram'].to_s.match?(/\A\d+\z/)
    config_error "vms[#{index}]: ram must be a number (got '#{vm['ram']}')"
  end

  # Validate cpu is numeric if specified
  if vm['cpu'] && !vm['cpu'].to_s.match?(/\A\d+\z/)
    config_error "vms[#{index}]: cpu must be a number (got '#{vm['cpu']}')"
  end
end

# Run provider check if available
default_provider_check = File.join(__dir__, 'providers', 'checks', default_provider)
if File.exist?(default_provider_check)
  eval File.read(default_provider_check)
end

# Main Vagrant configuration
Vagrant.configure(API_VERSION) do |config|
  # Create master VM (unless disabled)
  if enable_master
    master_fqdn = "#{master_name}.#{default_domain}"
    master_ip = "#{network}.10"

    # Variables needed by provider files
    name = master_fqdn
    ip = master_ip
    ram = master_ram
    cpu = master_cpu

    config.vm.define master_fqdn, primary: true do |dev|
      dev.vm.provider default_provider
      dev.vm.box = master_box
      dev.vm.hostname = master_name
      dev.ssh.insert_key = false
      dev.vm.synced_folder codebase, codedest

      # Mount additional master folders if configured
      master_folders.each do |folder|
        dev.vm.synced_folder folder['from'], folder['to']
      end

      # Load provider-specific settings
      provider_file = File.join(__dir__, 'providers', default_provider)
      if File.exist?(provider_file)
        eval File.read(provider_file)
      else
        config_error "Provider '#{default_provider}' is not supported. Missing: #{provider_file}"
      end

      # Load master provisioner if specified
      if provisioner != 'none'
        provisioner_file = File.join(__dir__, 'provisioners', provisioner, 'master')
        if File.exist?(provisioner_file)
          eval File.read(provisioner_file)
        else
          config_error "Provisioner '#{provisioner}' master config not found: #{provisioner_file}"
        end
      end
    end
  end

  # Iterate through client VMs
  count = 11 # Starting IP octet for client VMs
  vms.each do |server|
    vm_cpu      = server['cpu']&.to_i       || 1
    vm_ram      = server['ram']&.to_s       || '512'
    vm_box      = server['box']             || default_box
    vm_box_url  = server['boxurl']
    vm_folders  = server['folders']         || []
    vm_domain   = server['domain']          || default_domain
    vm_name     = server['name']
    vm_fqdn     = "#{vm_name}.#{vm_domain}"
    vm_ip       = "#{network}.#{count}"
    vm_provider = server['provider']        || default_provider

    count += 1

    # Run provider check for non-default providers
    if vm_provider != default_provider
      provider_check = File.join(__dir__, 'providers', 'checks', vm_provider)
      if File.exist?(provider_check)
        eval File.read(provider_check)
      end
    end

    # Variables needed by provider files
    name = vm_fqdn
    ip = vm_ip
    ram = vm_ram
    cpu = vm_cpu

    config.vm.define vm_fqdn do |dev|
      dev.vm.hostname = vm_fqdn
      dev.ssh.insert_key = false
      dev.vm.box = vm_box
      dev.vm.box_url = vm_box_url if vm_box_url

      # Mount synced folders
      vm_folders.each do |folder|
        dev.vm.synced_folder folder['from'], folder['to']
      end

      # Load provider-specific settings
      provider_file = File.join(__dir__, 'providers', vm_provider)
      if File.exist?(provider_file)
        eval File.read(provider_file)
      else
        config_error "Provider '#{vm_provider}' for '#{vm_fqdn}' is not supported. File an issue: https://github.com/lloydoliver/multi-vagrant/issues"
      end

      # Load client provisioner if applicable
      if %w[salt ansible].include?(provisioner)
        provisioner_file = File.join(__dir__, 'provisioners', provisioner, 'client')
        eval File.read(provisioner_file) if File.exist?(provisioner_file)
      end
    end
  end
end
